<mxfile host="app.diagrams.net" type="device"><diagram id="Diagrama de Contexto" name="Diagrama de Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="PLATAFORMA DE&lt;br&gt;DOMICILIOS&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;(Spring Boot)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710.0" y="430.0" width="380.0" height="380.0" as="geometry"/></mxCell><mxCell id="n3" value="Administrador" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="815.0" y="110.0" width="170.0" height="70.0" as="geometry"/></mxCell><mxCell id="n4" value="Cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110.0" y="455.0" width="170.0" height="70.0" as="geometry"/></mxCell><mxCell id="n5" value="Servicio de Mapas&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(OpenStreetMap)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110.0" y="675.0" width="170.0" height="70.0" as="geometry"/></mxCell><mxCell id="n6" value="Establecimiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520.0" y="455.0" width="170.0" height="70.0" as="geometry"/></mxCell><mxCell id="n7" value="Pasarela de Pagos&lt;br&