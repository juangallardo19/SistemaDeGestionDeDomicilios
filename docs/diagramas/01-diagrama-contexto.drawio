;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840.0" y="1055.0"/></Array></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7632;exitY=0.9251;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2143;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000.0" y="1015.0"/></Array></mxGeometry></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.0000;exitY=0.7857;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6579;entryY=0.9744;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="n9" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960.0" y="1055.0"/></Array></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Diagrama de Contexto - Plataforma de Domicilios&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="560.0" y="20.0" width="680.0" height="40.0" as="geometry"/></mxCell><mxCell id="n10" value="Consultas de supervisión,&lt;br&gt;cambio de estrategia de&lt;br&gt;asignación de repartidores&lt;br&gt;y del cálculo del tiempo&lt;br&gt;estimado de llegada" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630.0" y="215.0" width="240.0" height="74.0" as="geometry"/></mxCell><mxCell id="n11" value="Productos que lleva cada&lt;br&gt;domiciliario, disponibilidad&lt;br&gt;por establecimiento, alertas de&lt;br&gt;stock bajo o agotado, bitácora&lt;br&gt;de eventos de los pedidos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="930.0" y="215.0" width="260.0" height="74.0" as="geometry"/></mxCell><mxCell id="n12" value="Selección de establecimiento y productos con sus cantidades,&lt;br&gt;códigos de descuento, método de pago,&lt;br&gt;dirección de entrega, solicitud de cancelación" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="300.0" y="418.0" width="450.0" height="46.0" as="geometry"/></mxCell><mxCell id="n13" value="Catálogo con disponibilidad, cotización y total,&lt;br&gt;confirmación y referencia del pago, estado del pedido,&lt;br&gt;posición del repartidor, ruta, tiempo estimado&lt;br&gt;de llegada y notificaciones" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300.0" y="516.0" width="400.0" height="60.0" as="geometry"/></mxCell><mxCell id="n14" value="Coordenadas del establecimiento, del cliente&lt;br&gt;y posición del repartidor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="300.0" y="652.0" width="380.0" height="32.0" as="geometry"/></mxCell><mxCell id="n15" value="Mapa base y referencias para el trazado&lt;br&gt;de la ruta de entrega" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300.0" y="736.0" width="380.0" height="32.0" as="geometry"/></mxCell><mxCell id="n16" value="Catálogo y precios, ajustes de inventario,&lt;br&gt;inicio de la preparación del pedido,&lt;br&gt;solicitud de despacho" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1050.0" y="418.0" width="450.0" height="46.0" as="geometry"/></mxCell><mxCell id="n17" value="Pedidos entrantes, inventario actualizado,&lt;br&gt;alertas de stock y repartidor asignado" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100.0" y="516.0" width="400.0" height="32.0" as="geometry"/></mxCell><mxCell id="n18" value="Monto a cobrar y método de pago elegido&lt;br&gt;(efectivo, tarjeta o billetera digital)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1120.0" y="652.0" width="380.0" height="32.0" as="geometry"/></mxCell><mxCell id="n19" value="Resultado del pago (aprobado / rechazado)&lt;br&gt;y referencia de la transacción" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120.0" y="736.0" width="380.0" height="32.0" as="geometry"/></mxCell><mxCell id="n20" value="Ubicación actual (GPS),&lt;br&gt;inicio / fin de turno,&lt;br&gt;confirmación de entrega" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="585.0" y="963.0" width="205.0" height="46.0" as="geometry"/></mxCell><mxCell id="n21" value="Pedido asignado con sus productos,&lt;br&gt;dirección y ruta de entrega" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="585.0" y="1061.0" width="245.0" height="32.0" as="geometry"/></mxCell><mxCell id="n22" value="Crear, consultar y actualizar:&lt;br&gt;usuarios, establecimientos,&lt;br&gt;inventario, pedidos y rutas" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1010.0" y="963.0" width="210.0" height="46.0" as="geometry"/></mxCell><mxCell id="n23" value="Registros consultados y&lt;br&gt;confirmación de las transacciones" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;spacing=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="970.0" y="1061.0" width="250.0" height="32.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>