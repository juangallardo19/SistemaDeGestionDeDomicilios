<mxfile host="app.diagrams.net" type="device"><diagram id="Diagrama de Despliegue" name="Diagrama de Despliegue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1120" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="«device»&lt;br&gt;&lt;b&gt;Equipo del usuario (PC / portátil)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80.0" y="150.0" width="460.0" height="300.0" as="geometry"/></mxCell><mxCell id="n3" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Postman / navegador / IntelliJ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110.0" y="220.0" width="400.0" height="210.0" as="geometry"/></mxCell><mxCell id="n6" value="«device»&lt;br&gt;&lt;b&gt;Servidor de aplicaciones&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720.0" y="130.0" width="820.0" height="560.0" as="geometry"/></mxCell><mxCell id="n7" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;JVM - Java 17+&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750.0" y="200.0" width="760.0" height="470.0" as="geometry"/></mxCell><mxCell id="n8" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Spring Boot 3.3 · Tomcat embebido (puerto 8080)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#f8f9fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780.0" y="260.0" width="700.0" height="390.0" as="geometry"/></mxCell><mxCell id="n14" value="«device»&lt;br&gt;&lt;b&gt;Servidor de base de datos&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720.0" y="820.0" width="820.0" height="270.0" as="geometry"/></mxCell><mxCell id="n15" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Docker (docker-compose.yml)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750.0" y="890.0" width="760.0" height="180.0" as="geometry"/></mxCell><mxCell id="n4" value="«artifact»&lt;br&gt;&lt;b&gt;Colección Postman&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Peticiones de ejemplo a la API REST:&lt;br&gt;catálogo, pedidos, despacho, seguimiento&lt;br&gt;y panel del administrador&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="140.0" y="290.0" width="340.0" height="110.0" as="geometry"/></mxCell><mxCell id="n9" value="«artifact»&lt;br&gt;&lt;b&gt;plataforma-domicilios.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;web: controladores REST (/api/**)&lt;br&gt;servicio: Pedidos, Despacho, Seguimiento, Repartidores, Inventario, Administración&lt;br&gt;patrones: State · Decorator · Strategy · Observer&lt;br&gt;repositorio: Spring Data JPA (Hibernate)&lt;br&gt;dominio: Usuario, Pedido, Establecimiento, Inventario, Ruta...&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810.0" y="320.0" width="640.0" height="130.0" as="geometry"/></mxCell><mxCell id="n11" value="«artifact»&lt;br&gt;&lt;b&gt;DemoConsola + DatosIniciales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CommandLineRunner: carga datos&lt;br&gt;de ejemplo y ejecuta la demo&lt;br&gt;del flujo completo por consola&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810.0" y="480.0" width="300.0" height="140.0" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;H2 en memoria&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;perfil por defecto (demo)&lt;br&gt;jdbc:h2:mem:domicilios&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150.0" y="480.0" width="300.0" height="140.0" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;base de datos: domicilios_db&lt;br&gt;usuario: domicilios&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960.0" y="940.0" width="340.0" height="115.0" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Equipo del usuario&lt;/b&gt;&lt;br&gt;SO: Windows 10/11, macOS o Linux&lt;br&gt;Postman o navegador web&lt;br&gt;JDK 17+ y Maven para compilar el proyecto" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80.0" y="520.0" width="460.0" height="80.0" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Servidor de aplicaciones&lt;/b&gt;&lt;br&gt;SO: Ubuntu Server 22.04 LTS&lt;br&gt;CPU: 2 núcleos · RAM: 4 GB · Disco: 20 GB SSD&lt;br&gt;Java 17 (Temurin) · Spring Boot 3.3.4&lt;br&gt;Ejecución: java -jar plataforma-domicilios.jar" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640.0" y="130.0" width="400.0" height="96.0" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Endpoints principales&lt;/b&gt;&lt;br&gt;GET  /api/establecimientos&lt;br&gt;GET  /api/establecimientos/{id}/productos&lt;br&gt;POST /api/pedidos/cotizacion&lt;br&gt;POST /api/pedidos&lt;br&gt;GET  /api/pedidos/{id}&lt;br&gt;POST /api/pedidos/{id}/preparar&lt;br&gt;POST /api/pedidos/{id}/despachar&lt;br&gt;POST /api/pedidos/{id}/entregar&lt;br&gt;POST /api/pedidos/{id}/cancelar&lt;br&gt;GET  /api/pedidos/{id}/seguimiento&lt;br&gt;GET  /api/pedidos/{id}/notificaciones&lt;br&gt;POST /api/repartidores/{id}/avanzar&lt;br&gt;PUT  /api/repartidores/{id}/ubicacion&lt;br&gt;GET  /api/admin/repartidores/productos&lt;br&gt;GET  /api/admin/establecimientos/disponibilidad&lt;br&gt;GET|PUT /api/admin/estrategias" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640.0" y="290.0" width="400.0" height="240.0" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Servidor de base de datos&lt;/b&gt;&lt;br&gt;SO: Ubuntu Server 22.04 LTS&lt;br&gt;CPU: 2 núcleos · RAM: 4 GB · Disco: 50 GB SSD&lt;br&gt;Docker 24+ · imagen postgres:16&lt;br&gt;Volumen persistente: domicilios-datos" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640.0" y="860.0" width="400.0" height="96.0" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Tablas (generadas por JPA)&lt;/b&gt;&lt;br&gt;1. usuarios (+ clientes, repartidores, administradores)&lt;br&gt;2. establecimientos&lt;br&gt;3. productos&lt;br&gt;4. inventarios&lt;br&gt;5. items_inventario&lt;br&gt;6. pedidos&lt;br&gt;7. items_pedido&lt;br&gt;8. rutas&lt;br&gt;9. ruta_puntos" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80.0" y="840.0" width="460.0" height="170.0" as="geometry"/></mxCell><mxCell id="n5" value="" style="shape=note;size=6;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="458.0" y="296.0" width="14.0" height="18.0" as="geometry"/></mxCell><mxCell id="n10" value="" style="shape=note;size=6;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1428.0" y="326.0" width="14.0" height="18.0" as="geometry"/></mxCell><mxCell id="n12" value="" style="shape=note;size=6;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1088.0" y="486.0" width="14.0" height="18.0" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3036;entryDx=0;entryDy=0;entryPerimeter=0;f